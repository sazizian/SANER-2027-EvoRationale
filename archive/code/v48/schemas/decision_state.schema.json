{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved EvoRationale S0",
  "type": "object",
  "required": ["episode_id", "decision_id", "decision", "repository", "accepted_at", "cutoff_at", "human_approved", "central_element_ids"],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "accepted_at": {"type": "string", "format": "date-time"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "human_approved": {"const": true},
    "central_element_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "goals": {"$ref": "#/$defs/elementCollection"},
    "requirements": {"$ref": "#/$defs/elementCollection"},
    "assumptions": {"$ref": "#/$defs/elementCollection"},
    "original_evidence": {"$ref": "#/$defs/elementCollection"},
    "quality_attributes": {"$ref": "#/$defs/elementCollection"},
    "constraints_dependencies": {"$ref": "#/$defs/elementCollection"},
    "implementation_scope": {"$ref": "#/$defs/elementCollection"}
  },
  "$defs": {"elementCollection": {"type": "array", "items": {
    "type": "object", "required": ["id", "text", "source"],
    "properties": {"id": {"type": "string", "minLength": 1},
      "text": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1},
      "keywords": {"type": "array", "items": {"type": "string"}}}
  }}}
}
